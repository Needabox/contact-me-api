# Email delivery provider: "resend" or "console" (local dev/dry-run)
EMAIL_PROVIDER=console

# Verified sender address (supports "email@domain" or "Display Name <email@domain>")
CONTACT_FROM_EMAIL=

# Comma-separated destination inbox email address(es)
CONTACT_TO_EMAIL=

# Required only when EMAIL_PROVIDER=resend
RESEND_API_KEY=

# Optional override for Resend API base URL (defaults to https://api.resend.com)
# RESEND_BASE_URL=https://api.resend.com

# Optional comma-separated CORS allowlist (defaults to "*")
# ALLOWED_ORIGINS=https://example.com
